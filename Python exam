4. PCA (Very Very Important)
data=datasets::iris

data=subset(data,select=-Species)

pca=prcomp(data,
           scale=TRUE,
           center=TRUE)

summary(pca)

pca$rotation

biplot(pca)

pca.var=pca$sdev^2

propve=pca.var/sum(pca.var)

plot(propve,
     type="b",
     main="Scree Plot")

plot(cumsum(propve),
     type="b")
Viva:

Prcomp kisliye use hota hai?

Ans:
Dimension Reduction ke liye.



5. Decision Tree (Most Asked)

Examiner ka favourite.

library(rpart)
library(rpart.plot)

data=iris

sample_index=sample(150,100)

training=data[sample_index,]

testing=data[-sample_index,]

dtm=rpart(
Species~Sepal.Length+
Sepal.Width+
Petal.Length+
Petal.Width,
data=training,
method="class"
)

plot(dtm)
text(dtm)

rpart.plot(dtm)

pred=predict(
dtm,
testing,
type="class"
)

table(testing[,5],pred)

mean(testing[,5]==pred)


