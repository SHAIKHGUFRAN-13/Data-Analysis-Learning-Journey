def update_employee():

emp_id = int(input("Enter ID: "))

new_salary = float(input("Enter new salary: "))

conn = connect_db()

cursor = conn.cursor()

query = "UPDATE employees SET salary=%s WHERE id=%s"

cursor.execute(query, (new_salary, emp_id))

conn.commit()

print("Updated Successfully")

cursor.close()
conn.close()


