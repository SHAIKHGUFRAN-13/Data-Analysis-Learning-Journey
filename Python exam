def display_menu():
print("\n--- MENU ---")
print("1. Create Tuple")
print("2. Display Tuple")
print("3. Update Tuple")
print("4. Delete Element")
print("5. Exit")


def main():

my_tuple = ()

while True:

display_menu()

choice = int(input("Enter choice: "))

# CREATE
if choice == 1:

n = int(input("How many elements: "))

temp = []

for i in range(n):
value = input("Enter element: ")
temp.append(value)

my_tuple = tuple(temp)

print("Tuple Created:", my_tuple)

# READ
elif choice == 2:

print("Current Tuple:", my_tuple)

# UPDATE
elif choice == 3:

temp = list(my_tuple)

index = int(input("Enter index: "))
new_value = input("Enter new value: ")

if index >= 0 and index < len(temp):

temp[index] = new_value

my_tuple = tuple(temp)

print("Updated Tuple:", my_tuple)

else:
print("Invalid Index")

# DELETE
elif choice == 4:

temp = list(my_tuple)

value = input("Enter element to delete: ")

if value in temp:

temp.remove(value)

my_tuple = tuple(temp)

print("Tuple after delete:", my_tuple)

else:
print("Element not found")

# EXIT
elif choice == 5:

print("Program Ended")
break

else:
print("Invalid Choice")


if name == "main":
main()




#3333file handling

def menu():

print("\n--- FILE MENU ---")
print("1. Read File")
print("2. Write File")
print("3. Append File")
print("4. Exit")


def read_file():

try:

with open("practice.txt", "r") as file:

data = file.read()

print("\nFile Content:")
print(data)

except FileNotFoundError:

print("File not found")


def write_file():

text = input("Enter text: ")

with open("practice.txt", "w") as file:

file.write(text + "\n")

print("Data Written Successfully")


def append_file():

text = input("Enter text: ")

with open("practice.txt", "a") as file:

file.write(text + "\n")

print("Data Appended Successfully")


def main():

while True:

menu()

choice = int(input("Enter choice: "))

if choice == 1:
read_file()

elif choice == 2:
write_file()

elif choice == 3:
append_file()

elif choice == 4:
print("Program Closed")
break

else:
print("Invalid Choice")


if name == "main":
main()


