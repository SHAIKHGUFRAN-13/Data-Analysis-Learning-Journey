2. Missing Values (NA Handling)

Bahut Important

data=data.frame(
marks1=c(NA,22,NA,49,75),
marks2=c(81,14,NA,61,12)
)

print(data)

# Count NA
sum(is.na(data))

# Remove NA
na.omit(data)

# Replace NA with Mean
data$marks1[is.na(data$marks1)] =
mean(data$marks1,na.rm=TRUE)

print(data)


