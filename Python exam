def insert_employee():

name = input("Enter name: ")
age = int(input("Enter age: "))
dept = input("Enter department: ")
salary = float(input("Enter salary: "))

conn = connect_db()

cursor = conn.cursor()

query = """
INSERT INTO employees(name, age, department, salary)
VALUES(%s, %s, %s, %s)
"""

